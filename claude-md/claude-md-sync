#!/bin/bash
#
# claude-md-sync — compose CLAUDE.md from docs-API pages.
#
# Fetches the shared and (optional) node-local agent-context pages from the
# docs API, validates them, composes them with a DO-NOT-EDIT header, and
# installs the result atomically as a read-only CLAUDE.md.
#
# Fail-safe by design:
#   - a fetch failure or invalid payload leaves the existing CLAUDE.md alone
#   - the node fragment is optional; the shared fragment is required
#   - the installed file is chmod 444 with a header pointing at the edit path
#
# All knobs are env-overridable. Secrets come from ENV_FILE (KEY=value lines),
# typically /etc/docs-stack/claude-md-sync.env with DOCS_API_BASE and
# DOCS_API_KEY. Run by systemd timer; safe to run manually.

set -euo pipefail

ENV_FILE="${ENV_FILE:-/etc/docs-stack/claude-md-sync.env}"
if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    set -a; source "$ENV_FILE"; set +a
fi

DOCS_API_BASE="${DOCS_API_BASE:-http://localhost:8010}"
DOCS_API_KEY="${DOCS_API_KEY:-}"

HOSTNAME_SHORT="$(hostname -s)"
HOSTNAME_SHORT="${HOSTNAME_SHORT%.local}"   # macOS adds .local

# Fragments, in composition order (highest precedence first):
#   doctrine — engineering doctrine / agent rules (optional, soft-fail)
#   node     — this machine's context (optional, soft-fail)
#   shared   — context for every machine (required)
DOCTRINE_PAGE="${DOCTRINE_PAGE:-agent-context/doctrine.md}"
SHARED_PAGE="${SHARED_PAGE:-agent-context/shared.md}"
NODE_PAGE="${NODE_PAGE:-agent-context/nodes/${HOSTNAME_SHORT}.md}"

CLAUDE_DIR="${CLAUDE_DIR:-/root/.claude}"
CLAUDE_FILE="${CLAUDE_FILE:-${CLAUDE_DIR}/CLAUDE.md}"
STAGING_DIR="${STAGING_DIR:-/var/lib/docs-stack/claude-md-sync}"

CURL_MAX_TIME="${CURL_MAX_TIME:-30}"

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"; }
die() { log "FAIL: $*"; exit 1; }

[[ -n "$DOCS_API_KEY" ]] || die "DOCS_API_KEY not set (expected in $ENV_FILE)"
command -v jq >/dev/null || die "jq is required"
mkdir -p "$STAGING_DIR" "$CLAUDE_DIR"

# fetch_page <path> <outfile> — returns non-zero on any failure.
# Validates the payload starts with a Markdown H1 so an error page or empty
# body can never be installed as agent context.
fetch_page() {
    local page="$1" out="$2" body content
    body=$(curl -sf --max-time "$CURL_MAX_TIME" \
        -H "X-API-Key: ${DOCS_API_KEY}" \
        "${DOCS_API_BASE}/api/docs/pages/${page}") || return 1
    content=$(jq -er '.content' <<<"$body") || return 1
    [[ "$content" == \#\ * ]] || { log "reject ${page}: does not start with H1"; return 1; }
    printf '%s\n' "$content" > "$out"
}

shared_stage="${STAGING_DIR}/shared.md"
node_stage="${STAGING_DIR}/node.md"
doctrine_stage="${STAGING_DIR}/doctrine.md"

fetch_page "$SHARED_PAGE" "$shared_stage" \
    || die "could not fetch required shared fragment ${SHARED_PAGE} — keeping existing ${CLAUDE_FILE}"

doctrine_ok=0
if fetch_page "$DOCTRINE_PAGE" "$doctrine_stage"; then
    doctrine_ok=1
else
    log "doctrine fragment ${DOCTRINE_PAGE} unavailable — composing without it"
fi

node_ok=0
if fetch_page "$NODE_PAGE" "$node_stage"; then
    node_ok=1
else
    log "node fragment ${NODE_PAGE} unavailable — composing without it"
fi

composed="${STAGING_DIR}/CLAUDE.md.new"
{
    cat <<EOF
<!--
  DO NOT EDIT THIS FILE DIRECTLY — it is overwritten by claude-md-sync.
  Source of truth: the docs API pages
    ${DOCTRINE_PAGE}
    ${NODE_PAGE}
    ${SHARED_PAGE}
  To update: PUT the page via the docs API (or the write_doc MCP tool).
-->
EOF
    echo
    if [[ $doctrine_ok -eq 1 ]]; then cat "$doctrine_stage"; echo; fi
    if [[ $node_ok -eq 1 ]]; then cat "$node_stage"; echo; fi
    cat "$shared_stage"
    cat <<EOF

---
*⚠️ DO NOT EDIT — auto-synced from the docs API by claude-md-sync.*
*Last synced: $(date -u '+%Y-%m-%d %H:%M UTC') on ${HOSTNAME_SHORT}*
EOF
} > "$composed"

# Atomic install, read-only. chmod the old file writable first in case a
# previous run left it 444 (mv needs the directory, not the file, but some
# filesystems/backup tools care).
chmod 644 "$CLAUDE_FILE" 2>/dev/null || true
mv -f "$composed" "$CLAUDE_FILE"
chmod 444 "$CLAUDE_FILE"
log "installed ${CLAUDE_FILE} (doctrine=$([[ $doctrine_ok -eq 1 ]] && echo "$DOCTRINE_PAGE" || echo none), node=$([[ $node_ok -eq 1 ]] && echo "$NODE_PAGE" || echo none), shared=${SHARED_PAGE})"
