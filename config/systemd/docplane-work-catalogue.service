[Unit]
Description=Reconcile DocPlane generated Work catalogue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/docplane
EnvironmentFile=/etc/docplane/work-catalogue.env
ExecStart=/bin/bash /opt/docplane/scripts/run_work_catalogue_reconciliation.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock -/var/lib/node_exporter/textfile_collector
