[Unit]
Description=Observe the DocPlane Work catalogue authoritative source
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/docplane
EnvironmentFile=/etc/docplane/work-catalogue.env
ExecStart=/bin/bash /opt/docplane/scripts/run_work_catalogue_source_observer.sh
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock
