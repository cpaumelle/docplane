[Unit]
Description=Export DocPlane WORK-collaborator credential expiry every 10 minutes

[Timer]
# Expiry thresholds are days; a 10-minute cadence keeps the liveness series
# well inside the hub2 rules' freshness guard (30 min) and staleness alert (40 min).
OnActiveSec=1min
OnUnitInactiveSec=10min
AccuracySec=30s
RandomizedDelaySec=30s
Persistent=false
Unit=docplane-work-credential-expiry.service

[Install]
WantedBy=timers.target
