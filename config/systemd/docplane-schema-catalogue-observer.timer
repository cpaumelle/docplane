[Unit]
Description=Observe the DocPlane Schema catalogue source every 30 minutes

[Timer]
# Installation does not activate this timer. A later explicit gate owns enablement.
OnActiveSec=2min
OnUnitInactiveSec=30min
AccuracySec=1min
RandomizedDelaySec=1min
Persistent=false
Unit=docplane-schema-catalogue-observer.service

[Install]
WantedBy=timers.target
