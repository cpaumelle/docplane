[Unit]
Description=Export DocPlane WORK-collaborator credential expiry to the node-exporter textfile collector
After=network-online.target docker.service
Wants=network-online.target

[Service]
# Root because the read is `docker exec` into the DocPlane PostgreSQL container
# (resolved by compose labels docplane/postgres). Inside it, psql connects over
# the container-local socket as the password-less read-only role
# docplane_credential_expiry_observer (migration 021), which can read only two
# value-blind views. No EnvironmentFile and no credential: none is needed.
Type=oneshot
User=root
WorkingDirectory=/opt/docplane
ExecStart=/usr/bin/python3 /opt/docplane/scripts/work_credential_expiry_metrics.py --metrics-file /var/lib/node_exporter/textfile_collector/docplane_work_credential_expiry.prom
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
