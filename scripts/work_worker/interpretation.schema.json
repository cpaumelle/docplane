{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "librarian-interp-2",
 "title": "DocPlane Librarian interpretation output, version 2",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "run",
  "records",
  "mappings",
  "relations",
  "unresolved_references",
  "briefing",
  "proposals",
  "retrieval",
  "incomplete"
 ],
 "properties": {
  "schema_version": {
   "const": "librarian-interp-2"
  },
  "run": {
   "$ref": "#/$defs/run"
  },
  "records": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/record"
   }
  },
  "mappings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/mapping"
   }
  },
  "relations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/relation"
   }
  },
  "unresolved_references": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/reference"
   }
  },
  "briefing": {
   "$ref": "#/$defs/briefing"
  },
  "proposals": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/proposal"
   }
  },
  "retrieval": {
   "$ref": "#/$defs/retrieval"
  },
  "incomplete": {
   "type": "boolean",
   "description": "true when any scope read failed, was withheld, or the budget ran out; absence is then never evidence"
  }
 },
 "$defs": {
  "uuid": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "when": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z)?$"
  },
  "text": {
   "type": "string",
   "minLength": 1,
   "maxLength": 300,
   "pattern": "^[^\"`\\n\\r]*$",
   "description": "paraphrase, at most 30 words, no quotation marks"
  },
  "ident": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,48}$"
  },
  "party": {
   "type": [
    "string",
    "null"
   ],
   "maxLength": 80,
   "pattern": "^[^\"`\\n\\r]*$"
  },
  "locator": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_id",
    "part_id"
   ],
   "properties": {
    "record_id": {
     "$ref": "#/$defs/uuid"
    },
    "part_id": {
     "anyOf": [
      {
       "$ref": "#/$defs/ident"
      },
      {
       "type": "null"
      }
     ]
    },
    "para": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    }
   }
  },
  "fingerprint": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "projection",
    "value"
   ],
   "properties": {
    "projection": {
     "$ref": "#/$defs/ident"
    },
    "value": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "confirmation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "basis",
    "read_at"
   ],
   "description": "WORK reads confirm what is recorded and recorded state; they never confirm that an external action ran",
   "properties": {
    "basis": {
     "enum": [
      "RECORDED_CLAIM_ONLY",
      "WORK_STATE_READ_NOW",
      "DOCPLANE_PAGE_READ_NOW",
      "MODEL_READ_NOW",
      "EXTERNAL_UNVERIFIED"
     ]
    },
    "read_at": {
     "$ref": "#/$defs/when"
    },
    "verifier_needed": {
     "anyOf": [
      {
       "$ref": "#/$defs/text"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "run": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scope",
    "budget",
    "interpreter_version",
    "prompt_hash"
   ],
   "properties": {
    "scope": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "scope_id",
      "initiative_ids",
      "capture_statuses",
      "collected_at",
      "enumeration_limits",
      "authoritative_registers"
     ],
     "properties": {
      "scope_id": {
       "$ref": "#/$defs/ident"
      },
      "initiative_ids": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/uuid"
       },
       "uniqueItems": true
      },
      "capture_statuses": {
       "type": "array",
       "items": {
        "type": "string",
        "maxLength": 20
       }
      },
      "collected_at": {
       "$ref": "#/$defs/when"
      },
      "enumeration_limits": {
       "$ref": "#/$defs/text"
      },
      "authoritative_registers": {
       "type": "array",
       "description": "registers the run was told are authoritative for tracking (for example a programme register kept in git)",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "register_id",
         "description"
        ],
        "properties": {
         "register_id": {
          "$ref": "#/$defs/ident"
         },
         "description": {
          "$ref": "#/$defs/text"
         }
        }
       }
      }
     }
    },
    "budget": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "max_changed_records",
      "max_candidates_per_record",
      "max_extra_reads"
     ],
     "properties": {
      "max_changed_records": {
       "type": "integer",
       "minimum": 1
      },
      "max_candidates_per_record": {
       "type": "integer",
       "minimum": 0
      },
      "max_extra_reads": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "interpreter_version": {
     "$ref": "#/$defs/ident"
    },
    "prompt_hash": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "record": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record_id",
    "record_kind",
    "source_fingerprint",
    "depends_on",
    "parts"
   ],
   "properties": {
    "record_id": {
     "$ref": "#/$defs/uuid"
    },
    "record_kind": {
     "enum": [
      "capture",
      "initiative",
      "activity"
     ]
    },
    "source_fingerprint": {
     "$ref": "#/$defs/fingerprint"
    },
    "depends_on": {
     "type": "array",
     "description": "linked evidence this interpretation relied on; a changed fingerprint here invalidates this record's interpretation",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "record_id",
       "source_fingerprint"
      ],
      "properties": {
       "record_id": {
        "$ref": "#/$defs/uuid"
       },
       "source_fingerprint": {
        "$ref": "#/$defs/fingerprint"
       }
      }
     }
    },
    "parts": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/part"
     }
    }
   }
  },
  "part": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "part_id",
    "locator_para",
    "role",
    "interpretation",
    "epistemic",
    "temporal",
    "responsibility",
    "confirmation",
    "obligation"
   ],
   "properties": {
    "part_id": {
     "$ref": "#/$defs/ident"
    },
    "locator_para": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "role": {
     "enum": [
      "obligation",
      "evidence",
      "decision",
      "correction",
      "handover",
      "context",
      "background"
     ]
    },
    "interpretation": {
     "$ref": "#/$defs/text"
    },
    "epistemic": {
     "enum": [
      "explicit_statement",
      "supported_inference",
      "disputed",
      "unknown"
     ]
    },
    "temporal": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "reported_at",
      "observed_at",
      "valid_from",
      "valid_until"
     ],
     "properties": {
      "reported_at": {
       "$ref": "#/$defs/when"
      },
      "observed_at": {
       "$ref": "#/$defs/when"
      },
      "valid_from": {
       "$ref": "#/$defs/when"
      },
      "valid_until": {
       "$ref": "#/$defs/when"
      }
     }
    },
    "responsibility": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "authenticated_writer",
      "reported_producer",
      "claimed_accountable",
      "acknowledgement"
     ],
     "properties": {
      "authenticated_writer": {
       "$ref": "#/$defs/party"
      },
      "reported_producer": {
       "$ref": "#/$defs/party"
      },
      "claimed_accountable": {
       "$ref": "#/$defs/party"
      },
      "acknowledgement": {
       "$ref": "#/$defs/party"
      }
     }
    },
    "confirmation": {
     "$ref": "#/$defs/confirmation"
    },
    "obligation": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/obligation"
      }
     ]
    }
   }
  },
  "obligation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "local_id",
    "maps_to",
    "state",
    "due",
    "buried",
    "tracking"
   ],
   "properties": {
    "local_id": {
     "$ref": "#/$defs/ident"
    },
    "maps_to": {
     "anyOf": [
      {
       "$ref": "#/$defs/uuid"
      },
      {
       "type": "null"
      }
     ],
     "description": "prior obligation id when this is the same obligation re-read; null only when new"
    },
    "state": {
     "enum": [
      "OPEN",
      "DONE_IN_RECORD",
      "SUPERSEDED",
      "WITHDRAWN",
      "UNCLEAR"
     ]
    },
    "due": {
     "$ref": "#/$defs/when"
    },
    "buried": {
     "type": "boolean"
    },
    "tracking": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status",
      "targets"
     ],
     "properties": {
      "status": {
       "enum": [
        "TRACKED",
        "CANDIDATE",
        "MENTIONED_ONLY",
        "NOT_FOUND",
        "UNKNOWN"
       ]
      },
      "targets": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "record_id",
         "register_id",
         "entry_ref",
         "basis",
         "objective_stated",
         "disposition_stated",
         "target_state",
         "coverage"
        ],
        "properties": {
         "kind": {
          "enum": [
           "WORK_ITEM",
           "AUTHORITATIVE_REGISTER",
           "RECORD_ONLY"
          ]
         },
         "record_id": {
          "anyOf": [
           {
            "$ref": "#/$defs/uuid"
           },
           {
            "type": "null"
           }
          ]
         },
         "register_id": {
          "anyOf": [
           {
            "$ref": "#/$defs/ident"
           },
           {
            "type": "null"
           }
          ]
         },
         "entry_ref": {
          "type": [
           "string",
           "null"
          ],
          "maxLength": 80,
          "pattern": "^[^\"`\\n\\r]*$"
         },
         "basis": {
          "enum": [
           "STRUCTURAL",
           "CITED_ID",
           "REGISTER_ENTRY",
           "SEMANTIC"
          ]
         },
         "objective_stated": {
          "type": "boolean"
         },
         "disposition_stated": {
          "enum": [
           "ACCEPTED",
           "PLANNED",
           "ASSIGNED",
           "BACKLOG",
           "DONE",
           "NONE"
          ]
         },
         "target_state": {
          "enum": [
           "BACKLOG",
           "ACTIVE",
           "BLOCKED",
           "SOAKING",
           "PAUSED",
           "PARKED",
           "COMPLETE",
           "ABANDONED",
           "NOT_APPLICABLE"
          ]
         },
         "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "judgment",
           "reason"
          ],
          "properties": {
           "judgment": {
            "enum": [
             "ACTIVELY_COVERS",
             "DOES_NOT_ACTIVELY_COVER",
             "UNKNOWN"
            ]
           },
           "reason": {
            "enum": [
             "NONE",
             "ABANDONED",
             "COMPLETED_WITHOUT_THIS",
             "STALE",
             "PARTIAL_SCOPE",
             "UNKNOWN"
            ]
           }
          }
         }
        }
       }
      }
     },
     "description": "TRACKED: an identifiable work item or declared authoritative-register entry records the obligation (objective and disposition stated). Active coverage is judged per target."
    }
   }
  },
  "mapping": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "prior_ids",
    "new_local_ids"
   ],
   "properties": {
    "kind": {
     "enum": [
      "SPLIT",
      "MERGE",
      "RENAME"
     ]
    },
    "prior_ids": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/uuid"
     },
     "minItems": 1
    },
    "new_local_ids": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ident"
     },
     "minItems": 1
    }
   }
  },
  "relation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "relation_id",
    "type",
    "from",
    "to",
    "basis",
    "confidence",
    "evidence",
    "via_reference"
   ],
   "description": "CORRECTS_RETRACTS: a later part explicitly withdraws or fixes a named earlier part. CONTRADICTS_UNRESOLVED: two parts conflict and nothing resolves them. Both records are always kept.",
   "properties": {
    "relation_id": {
     "$ref": "#/$defs/ident"
    },
    "type": {
     "enum": [
      "CORRECTS_RETRACTS",
      "CONTRADICTS_UNRESOLVED",
      "SUPERSEDES",
      "DEPENDS_ON",
      "ACCEPTS",
      "BLOCKS",
      "DUPLICATES",
      "CAUSES",
      "PREVENTS",
      "FOLLOWS_UP",
      "SAME_DELIVERABLE"
     ]
    },
    "from": {
     "$ref": "#/$defs/locator"
    },
    "to": {
     "$ref": "#/$defs/locator"
    },
    "basis": {
     "enum": [
      "STRUCTURAL",
      "EXPLICIT_STATEMENT",
      "CITED_ID",
      "SEMANTIC"
     ]
    },
    "confidence": {
     "enum": [
      "high",
      "medium",
      "low"
     ]
    },
    "evidence": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/locator"
     },
     "minItems": 1
    },
    "via_reference": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "description": "index into unresolved_references when the cited id was a prefix"
    }
   }
  },
  "reference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "token",
    "cited_in",
    "scope_id",
    "outcome",
    "candidate_count",
    "resolved_record_id",
    "confirmed_by_full_read"
   ],
   "properties": {
    "token": {
     "type": "string",
     "maxLength": 40,
     "pattern": "^[A-Za-z0-9#/_.-]+$"
    },
    "cited_in": {
     "$ref": "#/$defs/locator"
    },
    "scope_id": {
     "$ref": "#/$defs/ident"
    },
    "outcome": {
     "enum": [
      "UNIQUE_CONFIRMED",
      "AMBIGUOUS",
      "NO_MATCH_IN_SCOPE",
      "NOT_ATTEMPTED"
     ]
    },
    "candidate_count": {
     "type": "integer",
     "minimum": 0
    },
    "resolved_record_id": {
     "anyOf": [
      {
       "$ref": "#/$defs/uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "confirmed_by_full_read": {
     "type": "boolean"
    }
   }
  },
  "briefing": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "workstream",
    "deliverable",
    "acceptance_as_stated",
    "status_lines",
    "open_obligations",
    "retractions",
    "unresolved_contradictions",
    "ready_to_close",
    "why"
   ],
   "properties": {
    "workstream": {
     "$ref": "#/$defs/text"
    },
    "deliverable": {
     "$ref": "#/$defs/text"
    },
    "acceptance_as_stated": {
     "anyOf": [
      {
       "$ref": "#/$defs/text"
      },
      {
       "type": "null"
      }
     ]
    },
    "status_lines": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "text",
       "confirmation",
       "evidence"
      ],
      "properties": {
       "text": {
        "$ref": "#/$defs/text"
       },
       "confirmation": {
        "$ref": "#/$defs/confirmation"
       },
       "evidence": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/locator"
        },
        "minItems": 1
       }
      }
     }
    },
    "open_obligations": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "local_id",
       "original_record",
       "text",
       "tracking_status",
       "coverage"
      ],
      "properties": {
       "local_id": {
        "$ref": "#/$defs/ident"
       },
       "original_record": {
        "$ref": "#/$defs/uuid"
       },
       "text": {
        "$ref": "#/$defs/text"
       },
       "tracking_status": {
        "enum": [
         "TRACKED",
         "CANDIDATE",
         "MENTIONED_ONLY",
         "NOT_FOUND",
         "UNKNOWN"
        ]
       },
       "coverage": {
        "enum": [
         "ACTIVELY_COVERS",
         "DOES_NOT_ACTIVELY_COVER",
         "UNKNOWN",
         "NO_TARGET"
        ]
       }
      }
     }
    },
    "retractions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ident"
     }
    },
    "unresolved_contradictions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ident"
     }
    },
    "ready_to_close": {
     "enum": [
      "yes",
      "no",
      "unknown"
     ]
    },
    "why": {
     "$ref": "#/$defs/text"
    }
   }
  },
  "proposal": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "proposal_id",
    "kind",
    "target",
    "change",
    "why",
    "alternatives",
    "evidence",
    "confidence_reason",
    "authority_stage",
    "capability",
    "tool_name"
   ],
   "properties": {
    "proposal_id": {
     "$ref": "#/$defs/ident"
    },
    "kind": {
     "enum": [
      "FILE",
      "METADATA",
      "LINK",
      "CONSOLIDATE",
      "NEXT_ACTION",
      "VERIFY",
      "CAPABILITY_GAP"
     ]
    },
    "target": {
     "type": "string",
     "maxLength": 80,
     "pattern": "^[^\"`\\n\\r]*$"
    },
    "change": {
     "$ref": "#/$defs/text"
    },
    "why": {
     "$ref": "#/$defs/text"
    },
    "alternatives": {
     "$ref": "#/$defs/text"
    },
    "evidence": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/locator"
     },
     "minItems": 1
    },
    "confidence_reason": {
     "$ref": "#/$defs/text"
    },
    "authority_stage": {
     "enum": [
      "PROPOSE_ONLY",
      "DELEGATED_REVERSIBLE",
      "SEPARATE_APPROVAL"
     ]
    },
    "capability": {
     "enum": [
      "EXISTING_TOOL",
      "CAPABILITY_GAP"
     ]
    },
    "tool_name": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 60
    }
   }
  },
  "retrieval": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "reads",
    "not_retrieved",
    "budget_exhausted"
   ],
   "properties": {
    "reads": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "record_id",
       "how_found",
       "read_ok"
      ],
      "properties": {
       "record_id": {
        "$ref": "#/$defs/uuid"
       },
       "how_found": {
        "enum": [
         "SEED",
         "STRUCTURAL",
         "CITED_ID",
         "SCOPE_ENUMERATION",
         "ADJACENCY",
         "SEARCH"
        ]
       },
       "read_ok": {
        "type": "boolean"
       }
      }
     }
    },
    "not_retrieved": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "what",
       "why"
      ],
      "properties": {
       "what": {
        "$ref": "#/$defs/text"
       },
       "why": {
        "$ref": "#/$defs/text"
       }
      }
     }
    },
    "budget_exhausted": {
     "type": "boolean"
    }
   }
  }
 },
 "description": "v2 corrects v1: TRACKED means an identifiable work item or authoritative-register entry records the obligation; whether it actively covers it is a separate judgment and the target's state (including ABANDONED or COMPLETE) stays visible."
}
