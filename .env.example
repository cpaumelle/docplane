POSTGRES_PASSWORD=replace-with-a-long-random-password
DOCPLANE_BOOTSTRAP_TOKEN=replace-with-a-separate-long-random-token
MCP_API_KEY=replace-with-a-long-random-token
DOCPLANE_EVENT_CURSOR_SECRET=replace-with-at-least-24-random-characters

# Populate after issuing a named contributor token through the bootstrap endpoint.
DOCPLANE_TOKEN=

DOCPLANE_API_PORT=8010
DOCPLANE_DASHBOARD_PORT=8051
DOCPLANE_SITE_PORT=8080
DOCPLANE_MCP_PORT=8049

# MCP host-header allowlist.
#
# Leave BOTH unset to get the port-aware default: localhost and 127.0.0.1, both
# bare and qualified with DOCPLANE_MCP_PORT. That default follows
# DOCPLANE_MCP_PORT automatically, so changing the port above needs no change
# here.
#
# Set them only to allow something the default cannot know about (a reverse
# proxy hostname, another loopback alias). Setting either one REPLACES the
# corresponding default entirely, so re-list the loopback forms if you still
# need them. Never use "*" — that disables DNS-rebinding protection.
#
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:8049,127.0.0.1:8049
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:8049,http://localhost:8049

# UID/GID owning the generated-site volume. Must match the docplane user baked
# into docs-api/Dockerfile; site-init uses these to hand the shared docs-site
# volume to that non-root user.
# DOCPLANE_SITE_UID=10001
# DOCPLANE_SITE_GID=10001
