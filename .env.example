# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
# NEVER commit .env.

# Database password (postgres is not exposed outside the compose network)
POSTGRES_PASSWORD=

# X-API-Key for every docs-api endpoint
DOCS_API_KEY=

# Bearer token for the MCP server (also used by docs-api to call /reindex)
MCP_API_KEY=

# Public-facing URLs used in API responses and error messages.
# Change these when you put the stack behind a reverse proxy.
DOCS_API_PUBLIC_URL=http://localhost:8010
DOCS_GUIDE_URL=http://localhost:8080/
